{
  "luci-app-campus-auth-guardian": {
    "description": "允许访问校园网认证守护配置",
    "read": {
      "uci": [ "campus-auth-guardian" ]
    },
    "write": {
      "uci": [ "campus-auth-guardian" ],
      "file": {
        "/usr/bin/campus-auth-guardian.sh": [ "exec" ],
        "/usr/bin/campus-auth-guardian.sh auth": [ "exec" ],
        "/usr/bin/campus-auth-guardian.sh check": [ "exec" ],
        "/etc/init.d/campus-auth-guardian": [ "exec" ],
        "/etc/init.d/campus-auth-guardian restart": [ "exec" ]
      }
    }
  }
}
